    "start": "node dist/index.js"
  },
  "dependencies": {
    "fastify": "^4.28.1",
    "mssql": "^11.0.1",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.5",
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
