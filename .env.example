# SQL Server — MTHAI_ppm_db1
DB_SERVER=mth-cl-mthsql
DB_PORT=1433
DB_NAME=MTHAI_ppm_db1
DB_USER=MTHAI_ppm
DB_PASSWORD=

# API
API_PORT=8002
API_HOST=0.0.0.0
API_KEY=mch_dev_12345

# Table/view names (optional — defaults shown)
VIEW_NAME=vw_job_nokey
MACHINE_TABLE=dbo.machine
JOB_TABLE=dbo.job_listx

# WB-UPH — SQLite central.db (local or network share path)
# Leave blank to disable wb-uph endpoints (returns 503)
CENTRAL_DB_PATH=\\server\share\central.db

# DA-UPH — PostgreSQL uph database (optional)
# Leave blank to disable da-uph endpoints (returns 503)
DA_DB_URL=postgresql://user:pass@host:5432/uph

# Oracle — ISO/FS historical & live data (optional)
# Set ORA_ENABLED=1 to enable; leave blank to use MSSQL only
ORA_ENABLED=0
ORA_USER=
ORA_PASSWORD=
ORA_DSN=
ORA_CLIENT_LIB=
ORA_VIEW=Vw_Asodowntime_2025on
ORA_LIVE_VIEW=EQ_USER.V_EQDOWNTIME
